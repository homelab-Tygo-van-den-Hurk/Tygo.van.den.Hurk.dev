---

import Section from '#src/components/section.astro';
import { Projects as Config } from '#src/config';

export interface Props { class?: string; }
---
<Section id='projects' title='Projects' class={Astro.props.class}>
  <p class='mx-auto w-fit text-justify'>
    These are my favorite projects. You can also <a
    class='hover:underline text-base0D hover:text-base07 transition-all duration-200'
    href='https://redirects.tygo.van.den.hurk.dev/github/personal'>visit
    my github profile</a> for all my repositories! 
  </p>
  <ul class="flex flex-wrap justify-center gap-4 gap-y-4 p-4">
    {...Config.config.map(repository => <li>
      <div class:list={[
        'transition-all duration-200 hover:-translate-y-1 mx-auto hover:border-base03', 
        'bg-base01 block max-w-sm p-6 border border-base02 rounded-lg shadow-xs group',
        'shadow-black/20 hover:shadow-black/30 hover:shadow-md',
      ]}>
        <h3 class="mb-3 text-2xl font-semibold tracking-tight font-headers leading-8">
          <a href={`https://github.com/${repository.user}`} tabindex="-1"
          class="text-base0D hover:underline transition-all duration-200 hover:text-base07">
            {(() => {
              const me = "Tygo-van-den-Hurk" as const;
              if (repository.user === me) return "Tygo";
              else return repository.user;
            })()}
          </a>
          &ThickSpace;/&ThickSpace;
          <a href={`https://github.com/${repository.user}/${repository.repo}`} tabindex="-1"
          class="text-base0D hover:underline transition-all duration-200 hover:text-base07">
            {repository.repo}
          </a>
        </h3>
        <p class="text-body mb-6 h-30 text-ellipsis line-clamp-5">
          {repository.desc}
        </p>
        <a href={`https://github.com/${repository.user}/${repository.repo}`} class:list={[
            'inline-flex items-center text-base01 bg-base0D box-border border border-transparent',
            'hover:bg-base07 transition-all duration-200 focus:ring-4 focus:ring-base07 shadow-xs',
            'leading-5 rounded-md text-sm px-4 py-2.5 focus:outline-none',
          ]}>
          Read more <span class="sr-only">about {repository.repo}</span>
          <svg class="w-4 h-4 ms-1.5 rtl:rotate-180 -me-0.5" 
            aria-hidden="true" xmlns="http://www.w3.org/2000/svg" 
            width="24" height="24" fill="none" viewBox="0 0 24 24">
            <path stroke="currentColor" stroke-linecap="round"
              stroke-linejoin="round" stroke-width="2"
              d="M19 12H5m14 0-4 4m4-4-4-4"
            />
          </svg>
        </a>
      </div>
    </li>)}
  </ul>
</Section>
