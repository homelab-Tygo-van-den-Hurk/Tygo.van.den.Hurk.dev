---
import "#repo/public/fonts/source-serif-pro/font.css";
import "#repo/public/fonts/old-standard-tt/font.css";
import "#src/styles/global.css";
---
<section class="w-screen h-screen bg-black p-10">
  <div class="grid grid-cols-4 w-full">
    <div style="background-color:#eff1f5" class="w-full h-10 flex items-center justify-center">base00</div>
    <div style="background-color:#ccd0da" class="w-full h-10 flex items-center justify-center">base01</div>
    <div style="background-color:#bcc0cc" class="w-full h-10 flex items-center justify-center">base02</div>
    <div style="background-color:#9ca0b0" class="w-full h-10 flex items-center justify-center">base03</div>
    <div style="background-color:#6c6f85" class="w-full h-10 flex items-center justify-center">base04</div>
    <div style="background-color:#4c4f69" class="w-full h-10 flex items-center justify-center">base05</div>
    <div style="background-color:#c8897d" class="w-full h-10 flex items-center justify-center">base06</div>
    <div style="background-color:#8994d0" class="w-full h-10 flex items-center justify-center">base07</div>
    <div style="background-color:#b84a61" class="w-full h-10 flex items-center justify-center">base08</div>
    <div style="background-color:#d88955" class="w-full h-10 flex items-center justify-center">base09</div>
    <div style="background-color:#c5964b" class="w-full h-10 flex items-center justify-center">base0A</div>
    <div style="background-color:#659858" class="w-full h-10 flex items-center justify-center">base0B</div>
    <div style="background-color:#57979b" class="w-full h-10 flex items-center justify-center">base0C</div>
    <div style="background-color:#5278c5" class="w-full h-10 flex items-center justify-center">base0D</div>
    <div style="background-color:#8866c0" class="w-full h-10 flex items-center justify-center">base0E</div>
    <div style="background-color:#c78484" class="w-full h-10 flex items-center justify-center">base0F</div>
  </div>
  <div class="w-full h-3"/>
  <div class="grid grid-cols-4 w-full">
    <div style="background-color:#303446;" class="w-full h-10 flex items-center justify-center">base00</div>
    <div style="background-color:#414559;" class="w-full h-10 flex items-center justify-center">base01</div>
    <div style="background-color:#51576d;" class="w-full h-10 flex items-center justify-center">base02</div>
    <div style="background-color:#737994;" class="w-full h-10 flex items-center justify-center">base03</div>
    <div style="background-color:#a5adce;" class="w-full h-10 flex items-center justify-center">base04</div>
    <div style="background-color:#c6d0f5;" class="w-full h-10 flex items-center justify-center">base05</div>
    <div style="background-color:#f0b8ad;" class="w-full h-10 flex items-center justify-center">base06</div>
    <div style="background-color:#a5a9e8;" class="w-full h-10 flex items-center justify-center">base07</div>
    <div style="background-color:#e56b72;" class="w-full h-10 flex items-center justify-center">base08</div>
    <div style="background-color:#f09265;" class="w-full h-10 flex items-center justify-center">base09</div>
    <div style="background-color:#e0bd72;" class="w-full h-10 flex items-center justify-center">base0A</div>
    <div style="background-color:#91c76f;" class="w-full h-10 flex items-center justify-center">base0B</div>
    <div style="background-color:#6fc1b5;" class="w-full h-10 flex items-center justify-center">base0C</div>
    <div style="background-color:#789ee8;" class="w-full h-10 flex items-center justify-center">base0D</div>
    <div style="background-color:#b98bdd;" class="w-full h-10 flex items-center justify-center">base0E</div>
    <div style="background-color:#e9a5a5;" class="w-full h-10 flex items-center justify-center">base0F</div>
  </div>
  <div class="grid grid-cols-4 w-full bg-white">
    <p class="font-body w-full block p-2">
      Source Serif 4
      <br/>
      <strong class="font-bold">Source Serif 4</strong>
      <br/>
      <em class="">Source Serif 4</em>
    </p>
    <p class="font-headers w-full block p-2">
      Old Standard TT
      <br/>
      <strong class="font-bold">Old Standard TT</strong>
      <br/>
      <em class="italics">Old Standard TT</em>
    </p>
  </div>
</section>