---
import { Competencies as Config } from '#src/config';
import Section from '#src/components/section.astro';
import List from '#src/components/list.astro';
export interface Props {
  class?: string;
}
---

<Section id="competencies" title="Competencies" class={Astro.props.class}>
  <p class="mx-auto w-fit text-justify">
    These are the competencies I've acquired with my projects and experience:
  </p>
  <div class="flex flex-wrap justify-center gap-4 pt-8">
    <div class:list={[
      'w-72 shrink-0',
      'p-8 bg-base01 rounded-lg border border-base02 hover:border-base04',
      'shadow-xs shadow-black/20 hover:shadow-black/30 hover:shadow-md',
      'duration-200 transition-all hover:-translate-y-1 h-fit',
    ]}>
      <h3 class:list={[
        'text-base05 text-xl text-center mb-4',
        'capitalize font-bold font-headers',
      ]}>
        Skills
      </h3>
      <List items={Config.config.skills} />
    </div>
    <div class:list={[
      'w-72 shrink-0',
      'p-8 bg-base01 rounded-lg border border-base02 hover:border-base04',
      'shadow-xs shadow-black/20 hover:shadow-black/30 hover:shadow-md',
      'duration-200 transition-all hover:-translate-y-1 h-fit',
    ]}>
      <h3 class:list={[
        'text-base05 text-xl text-center mb-4',
        'capitalize font-bold font-headers',
      ]}>
        Tools
      </h3>
      <List items={Config.config.tools} />
    </div>
    <div class:list={[
      'w-72 shrink-0',
      'p-8 bg-base01 rounded-lg border border-base02 hover:border-base04',
      'shadow-xs shadow-black/20 hover:shadow-black/30 hover:shadow-md',
      'duration-200 transition-all hover:-translate-y-1 h-fit',
    ]}>
      <h3 class:list={[
        'text-base05 text-xl text-center mb-4',
        'capitalize font-bold font-headers',
      ]}>
        Languages
      </h3>
      <List items={Config.config.languages} />
    </div>
  </div>
</Section>
