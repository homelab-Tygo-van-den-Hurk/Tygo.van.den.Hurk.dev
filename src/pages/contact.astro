---
import ContactSection from '#src/sections/contact.astro';
import Layout from '#src/layouts/main.astro';
---
<Layout header={false} footer={false} class='bg-base00!'>
  <div class="flex h-full w-full flex-col items-center justify-center gap-8 py-10">
    <div class="w-full">
      <ContactSection />
    </div>
    <div style="margin-top: 30px;">
      <p class="mx-auto w-fit text-justify">
        If this is not where you wanted to go, then you can <a href="/"
        class="text-base0D transition-all duration-200 hover:text-base07 hover:underline">
          visit the main page
        </a>.
      </p>
    </div>
  </div>
</Layout>
